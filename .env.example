# Copy this file to .env.local.
# With the Supabase keys left empty the app runs in LOCAL MODE: no login, and all
# data is kept in your browser. That is enough to try every screen on localhost.

# --- Demo mode -----------------------------------------------------------------
# true  = "Unlock" buttons succeed immediately, no PayFast involved.
# false = real PayFast checkout (needs the Supabase and PayFast keys below).
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (optional until you want real accounts) ---------------------------
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- PayFast (optional until you take payments) --------------------------------
# Sandbox credentials from https://sandbox.payfast.co.za
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# true = sandbox.payfast.co.za, false = live payments
PAYFAST_SANDBOX=true

# Public address of this app. PayFast must be able to reach /api/payfast/notify,
# so on localhost use a tunnel URL (for example from ngrok) while testing ITN.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
